# Configuration for deploy/s3rs.service (EnvironmentFile). Keep this file readable only by root
# and the s3rs group: it holds secrets. Every option is documented in the README.
# s3rs refuses to start while a secret or token below is still `change-me`.

S3RS_DATA_DIR=/var/lib/s3rs
S3RS_LISTEN=0.0.0.0:9000

# Admin credentials (more keys, with read-only access, bucket limits or policies, go in a
# credentials file; `systemctl reload s3rs` re-reads it).
S3RS_ACCESS_KEY=change-me
S3RS_SECRET_KEY=change-me-to-a-long-random-secret
#S3RS_CREDENTIALS_FILE=/etc/s3rs/credentials

# Server-side encryption: generate with `openssl rand -hex 32 > /etc/s3rs/master.key`
# (mode 0640, group s3rs). Losing this key means losing every SSE-S3 object.
#S3RS_ENCRYPTION_KEY_FILE=/etc/s3rs/master.key
#S3RS_ENCRYPT_BY_DEFAULT=1

# Native HTTPS (needs a build with --features tls); otherwise put a TLS proxy in front and set
# S3RS_BEHIND_PROXY=1.
#S3RS_TLS_CERT=/etc/s3rs/fullchain.pem
#S3RS_TLS_KEY=/etc/s3rs/privkey.pem
#S3RS_BEHIND_PROXY=1

# Bucket replication targets (see the README): `ID URL ACCESS_KEY SECRET_KEY [REGION]` per line.
#S3RS_REPLICATION_TARGETS=/etc/s3rs/replication-targets

# Virtual-hosted-style requests (<bucket>.s3.example.com).
#S3RS_DOMAIN=s3.example.com

# Operations: protect /_metrics, enable GET /_admin/backup, log every request as JSON.
S3RS_METRICS_TOKEN=change-me
S3RS_ADMIN_TOKEN=change-me
S3RS_ACCESS_LOG=json
