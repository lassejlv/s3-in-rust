# systemd unit for s3rs. Install:
#   sudo useradd --system --home-dir /var/lib/s3rs --shell /usr/sbin/nologin s3rs
#   sudo install -m 0755 s3rs /usr/local/bin/s3rs
#   sudo install -d -m 0750 -o root -g s3rs /etc/s3rs
#   sudo install -m 0640 -o root -g s3rs deploy/s3rs.env /etc/s3rs/s3rs.env   # then edit it
#   sudo install -m 0644 deploy/s3rs.service /etc/systemd/system/s3rs.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now s3rs
# `systemctl reload s3rs` re-reads the credentials file and the TLS certificate.

[Unit]
Description=s3rs S3-compatible object storage
Documentation=https://github.com/lassejlv/s3-in-rust
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=s3rs
Group=s3rs
EnvironmentFile=/etc/s3rs/s3rs.env
ExecStart=/usr/local/bin/s3rs
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM drains in-flight requests for up to 30 s, then flushes and exits.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=2
# Each open transfer needs a socket and a file; s3rs sizes --max-connections from this.
LimitNOFILE=65536

# Data lives in /var/lib/s3rs (created and owned by the service user).
StateDirectory=s3rs
StateDirectoryMode=0700
WorkingDirectory=/var/lib/s3rs

# Sandboxing: s3rs needs nothing but its data directory, its configuration and the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# A refused system call fails with EPERM instead of killing the server.
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
# To listen on a port below 1024 (e.g. 443), instead use:
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
UMask=0077

[Install]
WantedBy=multi-user.target
